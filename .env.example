# ==============================================================================
# HireSphere - Production & Development Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and update values for your environment.
# NEVER commit your actual '.env' containing real secrets to version control.

# ------------------------------------------------------------------------------
# 1. CORE DJANGO CONFIGURATION
# ------------------------------------------------------------------------------
# Set to 'production' or 'development'
ENVIRONMENT=development

# DEBUG: Set to 'False' in production. Must be False for live deployments.
DEBUG=True

# SECRET_KEY: A long, random cryptographic key.
# In production, generate using: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=django-insecure-mv-job-portal-secret-key-prod-change-in-env-2026

# ALLOWED_HOSTS: Comma-separated list of valid host/domain names.
# Never use '*' in production.
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend,web

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL in production; SQLite fallback in local dev)
# ------------------------------------------------------------------------------
# Option A: Discrete PostgreSQL variables
DB_ENGINE=django.db.backends.postgresql
DB_NAME=jobboard_db
DB_USER=jobboard_user
DB_PASSWORD=jobboard_secure_password_123!
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=600

# Option B: Connection URI (e.g. Render, Railway, Neon, Supabase, AWS RDS)
# If set, overrides the discrete variables above.
# DATABASE_URL=postgres://jobboard_user:jobboard_secure_password_123!@localhost:5432/jobboard_db

# ------------------------------------------------------------------------------
# 3. HTTPS & SECURITY HEADERS (Active when DEBUG=False)
# ------------------------------------------------------------------------------
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=31536000

# ------------------------------------------------------------------------------
# 4. CORS & CSRF TRUSTED ORIGINS
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:80
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:80

# ------------------------------------------------------------------------------
# 5. JWT AUTHENTICATION
# ------------------------------------------------------------------------------
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# ------------------------------------------------------------------------------
# 6. APPLICATION & FILE UPLOAD LIMITS
# ------------------------------------------------------------------------------
MAX_RESUME_SIZE_MB=5
SEED_DEMO_DATA=False

# ------------------------------------------------------------------------------
# 7. SERVER & CONTAINER TUNING
# ------------------------------------------------------------------------------
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
FRONTEND_PORT=80

# ------------------------------------------------------------------------------
# 8. FRONTEND (Vite / React)
# ------------------------------------------------------------------------------
# In local dev: http://localhost:8000/api
# In containerized/production behind Nginx reverse proxy: /api
# In split PaaS deployment (Vercel + Render): https://api.yourdomain.com/api
VITE_API_BASE_URL=http://localhost:8000/api

# ------------------------------------------------------------------------------
# 9. CLOUD OBJECT STORAGE (Optional: AWS S3 / Cloudflare R2 / Supabase Storage)
# ------------------------------------------------------------------------------
# Leave unset to use local media disk / persistent volume (media/resumes/)
# USE_S3=True
# AWS_STORAGE_BUCKET_NAME=your-bucket-name
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_S3_REGION_NAME=us-east-1
# AWS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
