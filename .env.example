# ===================================================
# Multi-Vendor Job Board Environment Configuration
# ===================================================

# General Django Settings
DEBUG=True
SECRET_KEY=change-me-in-production-use-a-strong-random-key-here
ALLOWED_HOSTS=localhost,127.0.0.1,web

# Database Configuration (PostgreSQL in production/docker; fallback to SQLite locally if unset)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=jobboard_db
DB_USER=jobboard_user
DB_PASSWORD=jobboard_secure_password_123!
DB_HOST=localhost
DB_PORT=5432

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# JWT Configuration
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# Resume Upload Configuration
MAX_RESUME_SIZE_MB=5

# Frontend Environment Variables (Vite)
VITE_API_BASE_URL=http://localhost:8000/api
